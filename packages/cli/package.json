{
  "name": "@drift-lock/cli",
  "version": "0.1.4-alpha",
  "description": "CLI and installer for DriftLock contract-aware agent context and checks.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "drift-lock": "./bin/drift-lock.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nullodyssey/drift-lock.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/nullodyssey/drift-lock/issues"
  },
  "homepage": "https://github.com/nullodyssey/drift-lock#readme",
  "keywords": [
    "cli",
    "ai",
    "agents",
    "drift",
    "contracts",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --clean --out-dir dist",
    "check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --passWithNoTests",
    "test:with-build": "pnpm --filter @drift-lock/core run build && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@drift-lock/core": "workspace:*",
    "commander": "^14.0.2"
  }
}
