{
  "name": "@drift-lock/core",
  "version": "0.1.4-alpha",
  "description": "Core parser, extractor, context renderer, and deterministic checks for DriftLock.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nullodyssey/drift-lock.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/nullodyssey/drift-lock/issues"
  },
  "homepage": "https://github.com/nullodyssey/drift-lock#readme",
  "keywords": [
    "ai",
    "agents",
    "drift",
    "contracts",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist",
    "check": "tsc --noEmit",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "ignore": "^7.0.5",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  }
}
