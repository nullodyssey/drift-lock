{
  "name": "eslint-plugin-drift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist",
    "check": "tsc --noEmit",
    "test": "pnpm --filter @drift/core run build && vitest run"
  },
  "dependencies": {
    "@drift/core": "workspace:*"
  },
  "peerDependencies": {
    "eslint": ">=9"
  }
}
