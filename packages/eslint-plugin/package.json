{
  "name": "@drift-core/eslint-plugin",
  "version": "0.1.1-alpha",
  "description": "ESLint 9 flat config plugin for DriftLock contracts and invariants.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nullodyssey/drift-lock.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/nullodyssey/drift-lock/issues"
  },
  "homepage": "https://github.com/nullodyssey/drift-lock#readme",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "ai",
    "agents",
    "drift",
    "contracts"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist",
    "check": "tsc --noEmit",
    "test": "pnpm --filter @drift-core/core run build && vitest run"
  },
  "dependencies": {
    "@drift-core/core": "workspace:*"
  },
  "peerDependencies": {
    "eslint": ">=9"
  }
}
