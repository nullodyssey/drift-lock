{
  "name": "eslint-plugin-drift-lock",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist",
    "check": "tsc --noEmit",
    "test": "pnpm --filter @drift-lock/core run build && vitest run"
  },
  "dependencies": {
    "@drift-lock/core": "workspace:*"
  },
  "peerDependencies": {
    "eslint": ">=9"
  }
}
