{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@drift-lock/core": ["packages/core/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["packages/**/*.ts"]
}
